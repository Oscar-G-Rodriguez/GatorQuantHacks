# Shared credentials for the repository; copy to root .env and keep it local.
# Hypothesis-specific settings belong in Hypotheses/<folder>/.env instead.
WEBULL_APP_KEY=your_app_key
WEBULL_APP_SECRET=your_app_secret
WEBULL_API_ENDPOINT=api.webull.com
WEBULL_REGION_ID=us

# Massive coverage preparation; shared key, never copied into research settings.
MASSIVE_API_KEY=your_massive_api_key

# Optional historical-options enrichment checks; free metadata is checked first.
DATABENTO_API_KEY=your_databento_api_key

# Optional HiPerGator destination for research job preparation.
# GQH_REMOTE_BASE=/blue/<allocation>/<username>/quanthacks/discovery
