# Shared experiment-settings template; copy into a selected hypothesis as .env.
# Fill these from the completed, committed plan. Credentials stay in root .env.
# The strategy file must be Hypotheses/<folder>/strategies/<name>.py.
WEBULL_STRATEGY=strategy
WEBULL_STRATEGY_PARAMS=
WEBULL_SYMBOLS=
WEBULL_CATEGORY=
WEBULL_TIMESPAN=
WEBULL_COUNT=
WEBULL_FROMDATE=
WEBULL_TODATE=
WEBULL_VISUALIZE=true
WEBULL_VISUALIZE_ENGINE=plotly
# Relative to the selected hypothesis folder.
WEBULL_VISUALIZE_OUTPUT=results/backtest_report.html
